TELEGRAM_BOT_TOKEN=
# Comma-separated; empty = any chat. Discover: send /chatid to the bot
TELEGRAM_ALLOWED_CHAT_IDS=

# Native on Mac: http://127.0.0.1:11434
# Docker bridge: http://host.docker.internal:11434
# Colima host network (./deploy/colima.sh): http://host.lima.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-mlx
OLLAMA_TIMEOUT=180

MAX_HISTORY_MESSAGES=6
MEMORY_PATH=memory.json

# LAN IP of HA — from Colima bridge this often fails; use ./deploy/colima.sh (host network)
HOME_ASSISTANT_URL=http://10.10.30.18:8123
HOME_ASSISTANT_TOKEN=

MAX_SEARCH_RESULTS=5
MAX_IMAGES=3

# DEBUG for investigation (docker compose logs); INFO in production
LOG_LEVEL=INFO

HA_ALL_ENTITIES_LIMIT=500
HA_TOPIC_MATCH_LIMIT=25
HA_TOOL_JSON_MAX_CHARS=14000

# Home Assistant control (off by default). Requires TELEGRAM_ALLOWED_CHAT_IDS.
# HA_CONTROL_ENABLED=1
# HA_CONTROL_DOMAINS=light,switch,fan,humidifier,vacuum,input_boolean
